#!/usr/bin/env bash
#
# Rolls the checked-out branch out. Run it on the server, inside the
# application directory.
# Without -e a failed `composer install` would be followed by a cache rebuild
# against half-installed dependencies.
set -euo pipefail

# Checked before anything on disk moves, so a refusal leaves the site as it was.
if [ ! -f .env.local ]; then
    echo "bin/deploy: .env.local is missing—aborting." >&2
    exit 1
fi

# A copied secret makes CSRF and the anti-spam timestamp forgeable, invisibly.
if ! grep -qE '^APP_SECRET=.+' .env.local || grep -qE '^APP_SECRET=(<ChangeMe|""$)' .env.local; then
    echo "bin/deploy: .env.local has no usable APP_SECRET—aborting." >&2
    exit 1
fi

committed_secret=$(grep -E '^APP_SECRET=' .env | cut -d= -f2-)
if [ -n "$committed_secret" ] && grep -qF "APP_SECRET=${committed_secret}" .env.local; then
    echo "bin/deploy: .env.local repeats the APP_SECRET from the repository—aborting." >&2
    exit 1
fi

# The committed `null://null` throws every mail away while the form says it was sent.
if ! grep -qE '^MAILER_DSN=.+' .env.local || grep -qE '^MAILER_DSN=null://' .env.local; then
    echo "bin/deploy: .env.local sets no usable MAILER_DSN—aborting." >&2
    exit 1
fi

# The value that takes effect is checked, whichever file it comes from.
for setting in CONTACT_TO CONTACT_FROM; do
    if [ -z "$(grep -hE "^${setting}=.+" .env.local .env 2>/dev/null | head -1 | cut -d= -f2-)" ]; then
        echo "bin/deploy: neither .env.local nor .env sets ${setting}—aborting." >&2
        exit 1
    fi
done

# Reads a setting as Dotenv does: the last line wins.
dotenv_value() {
    local value double single
    double='^"([^"]*)"[[:space:]]*(#.*)?$'
    single="^'([^']*)'[[:space:]]*(#.*)?\$"
    value=$(grep -hE "^[[:space:]]*(export[[:space:]]+)?$1=" "$2" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '\r' || true)
    if [[ "$value" =~ $double ]] || [[ "$value" =~ $single ]]; then
        value="${BASH_REMATCH[1]}"
    else
        value="${value%%[[:space:]]#*}"
        value="${value%"${value##*[![:space:]]}"}"
    fi
    printf '%s' "$value"
}

# True for a host only this machine or a private network reaches.
private_host() {
    local host octet
    host=$(printf '%s' "$1" | sed -E 's#^[a-zA-Z]+://##; s#[/?#].*$##; s#^[^@]*@##' | tr '[:upper:]' '[:lower:]')
    if [[ "$host" == \[* ]]; then
        return 0
    fi
    host="${host%%:*}"
    while [[ "$host" == *. ]]; do
        host="${host%.}"
    done
    if [[ "$host" != *.* ]] || [[ "$host" =~ (^|\.)(localhost|local|lan|test|internal|invalid|example|home\.arpa|ddev\.site)$ ]]; then
        return 0
    fi
    if [[ "$host" =~ ^(0|10|127)\. ]] || [[ "$host" =~ ^(169\.254|192\.168)\. ]] || [[ "$host" =~ ^172\.(1[6-9]|2[0-9]|3[01])\. ]] || [[ "$host" =~ ^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\. ]]; then
        return 0
    fi
    octet='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])'
    if [[ "$host" =~ (^|\.)(0x[0-9a-f]*|[0-9]+)$ ]] && ! [[ "$host" =~ ^$octet(\.$octet){3}$ ]]; then
        return 0
    fi
    return 1
}

# A `.env.local` from development may point kongtent at ddev, and every page
# with a post answers 500. Only `https`, so the key never travels readable.
kongtent_url_file=.env
if grep -qE '^[[:space:]]*(export[[:space:]]+)?KONGTENT_URL=' .env.local; then
    kongtent_url_file=.env.local
fi
kongtent_url=$(dotenv_value KONGTENT_URL "$kongtent_url_file")
if [[ ! "$kongtent_url" =~ ^https://[^[:space:]/]+ ]] || private_host "$kongtent_url"; then
    echo "bin/deploy: the KONGTENT_URL in effect, from ${kongtent_url_file}, is no public https address—aborting." >&2
    exit 1
fi

# Empty in `.env`, so an unset key would surface as a 401 from kongtent.
if [[ ! "$(dotenv_value KONGTENT_KEY .env.local)" =~ ^[^[:space:]]+$ ]]; then
    echo "bin/deploy: .env.local sets no KONGTENT_KEY—aborting." >&2
    exit 1
fi

# Without it the auto-scripts of `composer install` build the cache for dev.
if ! grep -qE '^APP_ENV=prod$' .env.local; then
    echo "bin/deploy: .env.local does not set APP_ENV=prod—aborting." >&2
    exit 1
fi

git fetch --all
git reset --hard origin/main

# Moved aside before `composer install`, whose `cache:clear` would load the old
# container and die on a dropped bundle; `rm -rf` races PHP-FPM, the rename is atomic.
if [ -d var/cache/prod ]; then
    discard="var/cache/prod.discard.$$"
    mv var/cache/prod "$discard"
    rm -rf "$discard" || true
fi

composer install --no-dev --optimize-autoloader

bin/console cache:clear --env=prod --no-debug

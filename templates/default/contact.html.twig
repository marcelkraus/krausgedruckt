{% extends 'base.html.twig' %}
{% import 'partials/_icons.html.twig' as icons %}

{% block title %}Kontakt · krausgedruckt von Marcel Kraus{% endblock %}
{% block meta_description %}Schreib uns über das Kontaktformular, per E-Mail oder per WhatsApp. Deine Anfrage ist unverbindlich und kostenlos.{% endblock %}

{% block main %}
    <section class="border-b border-neutral-200 bg-surface-warm">
        <div class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-20">
            <div class="max-w-2xl">
                {{ include('partials/_eyebrow.html.twig', { text: 'Kontakt' }) }}
                <h1 class="mt-5 font-display text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl">
                    Lass uns schreiben.
                    <span class="mt-3 block text-[0.8em] text-accent-on-light">Dein heißer Draht.</span>
                </h1>
                <p class="mt-5 text-lg leading-relaxed text-neutral-600">Wir freuen uns über einen Erstkontakt auf dem schriftlichen Wege. Deine Anfrage ist unverbindlich und mit keinerlei Kosten verbunden.</p>
            </div>
        </div>
    </section>

    {# Same split as the sibling site: the ways to reach us on the narrow
       side, the form on the wide one. The form is first in the document so
       that a stacked phone shows it before the links that lead away. #}
    <section class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-20">
        <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
            {# Form or confirmation, exactly as the sister site does it: after a
               successful submission the confirmation takes the form's place
               rather than living on a page of its own. #}
            <div class="lg:order-2">
                {% if app.flashes('contact_success') %}
                    <div class="flex items-start gap-4 rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm sm:gap-6 sm:p-10" role="status">
                        <span class="mt-0.5 shrink-0 text-accent-on-light">{{ icons.icon('check', 'h-7 w-7') }}</span>
                        <div>
                            <h2 class="font-display text-xl font-bold text-neutral-900">Vielen Dank für deine Nachricht!</h2>
                            <p class="mt-2 text-sm leading-relaxed text-neutral-600">Wir setzen uns so schnell wie möglich mit dir in Verbindung.</p>
                        </div>
                    </div>
                {% else %}
                    {{ include('partials/_contact_form.html.twig', {
                        errors: contact_errors,
                        old: contact_old,
                        ts: contact_ts,
                        ts_sig: contact_ts_sig,
                        focus: contact_focus
                    }, with_context = false) }}
                {% endif %}
            </div>

            <div class="lg:order-1">
                <dl class="divide-y divide-neutral-200 border-y border-neutral-200">
                    <div class="flex items-start gap-4 py-5">
                        <span class="mt-0.5 text-accent-on-light">{{ icons.icon('mail', 'h-5 w-5') }}</span>
                        <div>
                            <dt class="font-mono text-xs uppercase tracking-[0.15em] text-neutral-600">E-Mail</dt>
                            <dd class="mt-1.5 text-sm"><a class="font-semibold text-accent-on-light transition-colors hover:text-accent-on-light-hover" href="{{ path('app_contact_email') }}">Schreib uns eine E-Mail</a></dd>
                        </div>
                    </div>
                    <div class="flex items-start gap-4 py-5">
                        <span class="mt-0.5 text-accent-on-light">{{ icons.icon('chat', 'h-5 w-5') }}</span>
                        <div>
                            <dt class="font-mono text-xs uppercase tracking-[0.15em] text-neutral-600">WhatsApp</dt>
                            <dd class="mt-1.5 text-sm"><a class="font-semibold text-accent-on-light transition-colors hover:text-accent-on-light-hover" href="{{ path('app_contact_whats_app') }}">Schreib uns per WhatsApp</a></dd>
                        </div>
                    </div>
                    <div class="flex items-start gap-4 py-5">
                        <span class="mt-0.5 text-accent-on-light">{{ icons.icon('clock', 'h-5 w-5') }}</span>
                        <div>
                            <dt class="font-mono text-xs uppercase tracking-[0.15em] text-neutral-600">Reaktionszeit</dt>
                            <dd class="mt-1.5 text-sm text-neutral-800">In der Regel innerhalb eines Werktags</dd>
                        </div>
                    </div>
                </dl>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascript %}
    {{ parent() }}
    <script>
        // On an error re-render, move focus to the first invalid field so the
        // visitor sees exactly what to fix.
        (function () {
            const form = document.querySelector('[data-error-focus]');
            if (!form) {
                return;
            }
            const field = document.getElementById('f_' + form.dataset.errorFocus);
            if (field) {
                field.focus();
                field.scrollIntoView({ block: 'center' });
            }
        }());
    </script>
{% endblock %}

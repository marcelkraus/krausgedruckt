{% extends 'base.html.twig' %}
{% import 'partials/_icons.html.twig' as icons %}

{% block title %}Referenzen · krausgedruckt von Marcel Kraus{% endblock %}
{% block meta_description %}Ein Einblick in unsere bunte Welt: gedruckte Ersatzteile, Werkzeuge und Dekostücke aus der Werkstatt von krausgedruckt in Erftstadt bei Köln.{% endblock %}

{% block main %}
    <section class="border-b border-neutral-200 bg-surface-warm">
        <div class="mx-auto max-w-6xl px-6 pt-36 pb-16 lg:px-8 lg:pt-40 lg:pb-20">
            <div class="max-w-2xl">
                {{ include('partials/_eyebrow.html.twig', { text: 'Referenzen' }) }}
                <h1 class="mt-5 font-display text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl">
                    Unsere Referenzen.
                    <span class="mt-3 block text-[0.8em] text-accent-on-light">Ein kleiner Einblick in unsere bunte Welt.</span>
                </h1>
            </div>
        </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-20">
        <h2 class="sr-only">Alle Referenzen</h2>
        {% if references %}
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {% for reference in references %}
                    {{ include('partials/_reference_card.html.twig', { reference: reference }) }}
                {% endfor %}
            </div>
        {% else %}
            <p class="text-base leading-relaxed text-neutral-600">Hier ist gerade nichts zu sehen – wir arbeiten daran.</p>
        {% endif %}

        {# Der Bezug ist echt, nicht dekorativ: Aus jeder Referenz baut das
           Backend eine Instagram-Bildunterschrift — die Referenzen sind die
           Beiträge. Wer hier durch ist, findet dort die Fortsetzung. #}
        <div class="mt-12">
            {{ include('partials/_link_arrow.html.twig', {
                href: instagram_url,
                label: 'Laufend weitere Inhalte auf Instagram',
                icon: 'external',
                external: true,
            }, with_context = false) }}
        </div>
    </section>

    {{ include('partials/_conversion_band.html.twig', { title: 'Und jetzt deins?', text: 'Erzähle uns von deiner Idee – unverbindlich und ohne Kosten.' }, with_context = false) }}
{% endblock %}

{% extends 'base.html.twig' %}
{% import 'partials/_icons.html.twig' as icons %}

{% block title %}Häufig gestellte Fragen · krausgedruckt von Marcel Kraus{% endblock %}
{% block meta_description %}Antworten auf die Fragen, die uns am häufigsten erreichen: Kosten, Materialien, 3D-Modelle und der Ablauf einer Anfrage bei krausgedruckt.{% endblock %}

{% block structured_data %}
    {% if faqEntries %}
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": [
                {%- for faqEntry in faqEntries %}
                {
                    "@type": "Question",
                    "name": {{ faqEntry.question|json_encode|raw }},
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": {{ faqEntry.answer|markdown_to_html|striptags|trim|json_encode|raw }}
                    }
                }{{ not loop.last ? ',' }}
                {%- endfor %}
            ]
        }
        </script>
    {% endif %}
{% endblock %}

{% block main %}
    <section class="border-b border-neutral-200 bg-surface-warm">
        <div class="mx-auto max-w-6xl px-6 pt-36 pb-16 lg:px-8 lg:pt-40 lg:pb-20">
            <div class="max-w-2xl">
                {{ include('partials/_eyebrow.html.twig', { text: 'Häufig gestellte Fragen' }) }}
                <h1 class="mt-5 font-display text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl">
                    Häufig gestellte Fragen.
                    <span class="mt-3 block text-[0.8em] text-accent-on-light">Du fragst, wir antworten.</span>
                </h1>
            </div>
        </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-20">
        {# Two columns: the entries are short and independent of each other,
           so the page stays scannable instead of turning into one long
           ribbon. A grid fills row by row, which keeps the reading order
           left to right.

           An odd number of entries would leave a hole in the last row. The
           last card then spans both columns instead — the count is edited in
           the backend and must not be something anyone has to keep even. #}
        <dl class="grid gap-6 md:grid-cols-2">
            {% for faqEntry in faqEntries %}
                <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm{{ loop.last and loop.length is odd ? ' md:col-span-2' }}">
                    <dt class="font-display text-lg font-bold text-neutral-900">{{ faqEntry.question }}</dt>
                    <dd class="prose prose-neutral mt-3 max-w-none text-base prose-a:font-semibold prose-a:text-accent-on-light prose-a:no-underline hover:prose-a:underline">{{ faqEntry.answer | markdown_to_html }}</dd>
                </div>
            {% endfor %}
        </dl>

        <div class="mt-10">
            {{ include('partials/_conversion_band.html.twig', {
                title: 'Deine Frage war nicht dabei?',
                text: 'Dann frag uns einfach – unverbindlich und ohne Kosten.',
                label: 'Jetzt fragen',
                boxed: true
            }, with_context = false) }}
        </div>
    </section>
{% endblock %}

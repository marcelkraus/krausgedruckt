{% extends 'base.html.twig' %}
{% import 'partials/_icons.html.twig' as icons %}

{% block title %}Der 3D-Druck-Kostenrechner · krausgedruckt von Marcel Kraus{% endblock %}
{% block meta_description %}Die App bietet dir einen einfachen und schnellen Überblick über die realen Gesamtkosten deiner 3D-Druck-Projekte. Für iPhone und iPad.{% endblock %}

{% block main %}
    {# ── Hero ───────────────────────────────────────────────────── #}
    <section class="border-b border-neutral-200 bg-surface-warm pt-20">
        <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-16 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16 lg:px-8 lg:py-20">
            <div class="order-2 lg:order-1">
                {{ include('partials/_eyebrow.html.twig', { text: 'App für iPhone und iPad' }) }}
                <h1 class="mt-5 font-display text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl">
                    Der 3D-Druck-Kostenrechner.
                    <span class="mt-3 block text-[0.8em] text-accent-on-light">Alles, was du für deine Kalkulation brauchst.</span>
                </h1>
                <div class="mt-10 flex flex-wrap items-center justify-center gap-4 lg:justify-start">
                    <a href="{{ appStoreUrlMobile }}"><img src="{{ asset('images/app-store-badge-mobile.svg') }}" alt="Laden im App Store" class="h-14"></a>
                </div>
            </div>
            <div class="order-1 justify-self-center lg:order-2 lg:justify-self-end">
                <img src="{{ asset('images/app-icon.png') }}" alt="Das Symbol des 3D-Druck-Kostenrechners" class="h-40 w-40 rounded-[22%] shadow-lg sm:h-48 sm:w-48">
            </div>
        </div>
    </section>

    {# ── Beschreibung ───────────────────────────────────────────── #}
    <section class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-20">
        <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-16">
            <div>
                {{ include('partials/_eyebrow.html.twig', { text: 'Funktionsumfang' }) }}
                <h2 class="mt-5 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
                    Die Kosten im Blick.
                    <span class="mt-3 block text-[0.8em] text-accent-on-light">Einfach. Schnell. Kostenlos.</span>
                </h2>
                <div class="mt-6 space-y-4 text-base leading-relaxed text-neutral-600">
                    <p>Der 3D-Druck-Kostenrechner gibt dir einen schnellen und einfachen Überblick über die <em>wirklichen</em> Gesamtkosten deiner 3D-Druck-Projekte, bestehend aus den Material-, Arbeits- und Betriebskosten.</p>
                    <p>Dabei ist die Grundfunktionalität der App – die einfache Kostenberechnung von 3D-Drucken – zu 100 % kostenlos. Dies bleibt auch so, für immer.</p>
                    <p>Entwickelt hat die App Marcel selbst. Einen hohen Wert legen wir dabei auf den Schutz deiner Daten: Sie ist komplett werbefrei, trackt dich nicht und erfasst vor allem keine persönlichen Daten.</p>
                </div>
            </div>

            <div class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
                {{ include('partials/_eyebrow.html.twig', { text: 'PLUS' }) }}
                <h3 class="mt-4 font-display text-xl font-bold text-neutral-900">
                    Du willst mehr?
                    <span class="mt-3 block text-[0.8em] text-accent-on-light">Dann wird es Zeit für PLUS.</span>
                </h3>
                <div class="mt-4 space-y-4 text-sm leading-relaxed text-neutral-600">
                    <p>PLUS ist das kostenpflichtige Paket an Zusatzfunktionen, das du über den App Store kaufen kannst.</p>
                    <p>PLUS ermöglicht dir die Speicherung von Berechnungen, die Erstellung und Auswahl von Profilen und die Berechnung deines Gewinns.</p>
                    <p>PLUS ist dabei ein einmaliger Kauf – kein Abo. Falls du langfristig Freude mit der App hast, würden wir uns dennoch ab und an über ein Trinkgeld freuen… 😉</p>
                </div>
            </div>
        </div>
    </section>


    {# ── Verweis auf die Schwestermarke ─────────────────────────── #}
    {{ include('partials/_sibling_band.html.twig', {
        title: 'Du möchtest auch eine App?<br>Marcel baut auch Software.',
        text: 'Der 3D-Druck-Kostenrechner ist ein Teil seines Portfolios. Unter der Marke <strong>krausgebaut</strong> baut Marcel Apps &amp; Websites – und kümmert sich auf Wunsch auch um die IT vor Ort.',
        href: 'https://www.krausgebaut.de',
        label: 'krausgebaut besuchen'
    }, with_context = false) }}

    {# ── Konversionsband ────────────────────────────────────────── #}
    {# Same shell as every other closing band; only the action differs, because
       here it is a store badge rather than the enquiry button. #}
    {% embed 'partials/_conversion_band.html.twig' with {
        title: 'Jetzt kostenlos herunterladen.',
        text: 'Verfügbar für iPhone und iPad.',
        appStoreUrlMobile: appStoreUrlMobile
    } only %}
        {% block actions %}
            <a href="{{ appStoreUrlMobile }}"><img src="{{ asset('images/app-store-badge-mobile.svg') }}" alt="Laden im App Store" class="h-14"></a>
        {% endblock %}
    {% endembed %}

{% endblock %}

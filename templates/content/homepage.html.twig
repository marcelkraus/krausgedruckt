{% extends 'base.html.twig' %}
{% import 'partials/_icons.html.twig' as icons %}

{% block structured_data %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "krausgedruckt",
        "image": "{{ app.request.schemeAndHttpHost ~ asset('images/sharing.jpg') }}",
        "url": "{{ url('app_homepage') }}",
        "priceRange": "€€",
        "areaServed": [
            { "@type": "City", "name": "Erftstadt" },
            { "@type": "City", "name": "Köln" },
            { "@type": "AdministrativeArea", "name": "Rhein-Erft-Kreis" }
        ],
        "address": {
            "@type": "PostalAddress",
            "addressLocality": "Erftstadt",
            "addressRegion": "NRW",
            "addressCountry": "DE"
        },
        "founder": {
            "@type": "Person",
            "name": "Marcel Kraus",
            "url": "https://www.marcelkraus.de"
        }
    }
    </script>
{% endblock %}

{% block main %}
    {# ── Hero ───────────────────────────────────────────────────── #}
    {# The grid spans the full width so the photo can bleed off the right
       edge. The text column is capped at half the container width and
       pushed right, which lands its left edge exactly on the container
       gutter every other section uses. #}
    <section class="border-b border-neutral-200 bg-surface-warm pt-20">
        <div class="items-stretch lg:grid lg:grid-cols-2">
            <div class="animate-rise mx-auto w-full max-w-[36rem] px-6 py-16 lg:mr-0 lg:ml-auto lg:py-24 lg:pr-12 lg:pl-8">
                {{ include('partials/_eyebrow.html.twig', { text: '3D-Druck aus Erftstadt bei Köln' }) }}
                <h1 class="mt-6 font-display text-4xl font-bold leading-[1.1] tracking-tight text-neutral-900 sm:text-5xl lg:text-6xl">
                    <span class="text-accent-on-light">Du hast die Idee.</span><br>
                    Wir machen sie greifbar!
                </h1>
                <p class="mt-7 max-w-md text-lg leading-relaxed text-neutral-600">Wir bieten dir individuellen 3D-Druck. Kompetent, zeitnah, bezahlbar.</p>
                <p class="mt-4 max-w-md text-lg leading-relaxed text-neutral-600">Nicht nur ausgedruckt. <span class="font-semibold text-neutral-900">krausgedruckt</span>.</p>

                <div class="mt-10 flex flex-wrap items-center gap-4">
                    {{ include('partials/_button.html.twig', { href: path('app_contact'), label: 'Jetzt anfragen' }, with_context = false) }}
                    <a href="{{ path('app_print_order') }}" class="group inline-flex items-center gap-2 px-2 py-3.5 font-mono text-sm uppercase tracking-[0.15em] text-neutral-600 transition-colors hover:text-accent-on-light">
                        Modell drucken
                        <span class="transition-transform group-hover:translate-x-1">{{ icons.icon('arrow', 'h-4 w-4') }}</span>
                    </a>
                </div>

            </div>

            {# The product carries the hero. No type sits on the photo, so the
               contrast never depends on the crop. #}
            <div class="relative min-h-[20rem] lg:min-h-full">
                <img src="{{ asset('images/prusa-mk4s-with-print-on-black-background--square.jpg') }}"
                     alt="Ein Prusa MK4S mit einem frisch gedruckten Teil"
                     class="absolute inset-0 h-full w-full object-cover lg:rounded-bl-[2rem]">
            </div>
        </div>
    </section>

    {# ── Angebot ────────────────────────────────────────────────── #}
    <section class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
        <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-16">
            <div>
                {{ include('partials/_eyebrow.html.twig', { text: 'Angebot' }) }}
                <h2 class="mt-5 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
                    Unser Angebot?
                    <span class="mt-3 block text-[0.8em] text-accent-on-light">Vielschichtig.</span>
                </h2>
                <div class="mt-6 space-y-4 text-base leading-relaxed text-neutral-600">
                    <p>Als erfahrene 3D-Druck-Dienstleister bieten wir dir maßgeschneiderte Lösungen für die additive Fertigung von Bauteilen aller Art. Egal ob Prototypen, funktionale Teile oder individuelle 3D-Modelle, wir machen deine Idee greifbar und bringen dein 3D-Modell schnell und präzise in die Realität.</p>
                    <p>Dabei verzichten wir auf unnötigen Fachjargon und komplizierte Materialdiskussionen. Du erzählst uns einfach, wofür du dein gewünschtes Teil benötigst, und wir empfehlen das optimale Material für deinen 3D-Druck.</p>
                    <p>Ob Einzelstücke, Kleinserien oder größere Stückzahlen, beim 3D-Druck gibt es keine Mindestabnahmemenge. Das macht das Verfahren besonders flexibel und eignet sich perfekt für individuelle Projekte und Prototyping.</p>
                    <p>Eine Übersicht unserer veröffentlichten 3D-Modelle: von Zubehör für ferngesteuerte Modellautos über praktische Werkzeuge bis hin zu Ersatzteilen für Fahrzeuge, findest du schon heute in unserem stetig wachsenden <a class="font-semibold text-accent-on-light transition-colors hover:text-accent-on-light-hover" href="https://www.printables.com/@krausgedruckt">Printables-Profil</a>.</p>
                </div>
            </div>

            {# The sustainability promise sits apart, as its own card. #}
            <div class="overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm">
                <img class="aspect-16/9 w-full object-cover" src="{{ asset('images/prusa-core-one-in-workshop--wide.jpg') }}" alt="Ein Original Prusa CORE One">
                <div class="p-8">
                    {{ include('partials/_eyebrow.html.twig', { text: 'Anspruch' }) }}
                    <h3 class="mt-4 font-display text-xl font-bold text-neutral-900">Möglichst nachhaltig.</h3>
                    <div class="mt-4 space-y-4 text-sm leading-relaxed text-neutral-600">
                        <p>Als Europäer legen wir großen Wert auf eine Fertigung in Europa. So unterstützen wir aktiv die europäische Wirtschaft und achten auf nachhaltige Produktionswege.</p>
                        <p>Unsere 3D-Drucke entstehen ausschließlich auf Druckern der Firma Prusa Research aus Tschechien. Das verwendete Material stammt zum Großteil aus Deutschland (Freren, Emskirchen, Bonn) oder ebenfalls von Prusa Research.</p>
                        <p>Wenn eine bestimmte Farbe oder ein spezielles Material benötigt wird, das nicht in Europa verfügbar ist, weichen wir transparent auf alternative Fertigungsorte aus, um deine Wünsche bestmöglich zu erfüllen.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ── Blog ───────────────────────────────────────────────────── #}
    {% if posts %}
        <section class="border-y border-neutral-200 bg-surface-warm">
            <div class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
                <div class="max-w-2xl">
                    {{ include('partials/_eyebrow.html.twig', { text: 'Blog' }) }}
                    <h2 class="mt-5 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">Neues aus dem Drucker</h2>
                    <p class="mt-5 text-lg leading-relaxed text-neutral-600">Unser Blog gibt dir einen kleinen Einblick in unsere bunte Welt – ob Referenzen, Gedanken oder Updates in der Druckfarm.</p>
                </div>

                <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    {# Three cards, and the grid holds two between `sm` and `lg`.
                       Rather than leaving the third one alone on its own row,
                       that width shows two: the section is a teaser, and the
                       link below it leads to all of them anyway. #}
                    {% for post in posts %}
                        {{ include('partials/_post_card.html.twig', {
                            post: post,
                            class: loop.index > 2 ? 'sm:hidden lg:flex' : ''
                        }, with_context = false) }}
                    {% endfor %}
                </div>

                <div class="mt-10">
                    {{ include('partials/_link_arrow.html.twig', {
                        href: path('app_blog'),
                        label: 'Alle Beiträge ansehen',
                    }, with_context = false) }}
                </div>
            </div>
        </section>
    {% endif %}

    {# ── Druckauftrag ───────────────────────────────────────────── #}
    {# Whoever has just seen examples splits here into “I want one of my own”
       and “I want one off the shelf”. The own way comes first: it is the one
       this site is built for, and it is what the shop band's “Lieber…”
       answers. The two bands keep the rhythm alternating – blog on warm,
       this one on white, the shop back on warm, then the dark section.

       It carries an eyebrow because it is an offer rather than furniture,
       and none of the other calls of the band do. Without a picture: the
       three photographs of the page are spoken for, and showing one of them
       a second time would be worse than type. #}
    {{ include('partials/_conversion_band.html.twig', {
        eyebrow: 'Modell drucken',
        title: 'Du hast ein fertiges Modell gefunden?',
        text: 'Nutze unser Formular: Füge die Adresse der Printables-Detailseite ein, wähle deine gewünschten Eigenschaften und du bekommst innerhalb weniger Stunden dein persönliches Angebot.',
        label: 'Modell drucken',
        href: path('app_print_order'),
        tone: 'plain'
    }, with_context = false) }}

    {# ── Shop ───────────────────────────────────────────────────── #}
    {# The other way to buy, and deliberately the second one. It keeps the
       picture and its size; what it gives up is being the first way out of
       the page, before the visitor has seen the way that stays on it. #}
    {{ include('partials/_conversion_band.html.twig', {
        title: 'Lieber sofort etwas Fertiges?',
        text: 'Ausgewählte Produkte bieten wir in unserem Etsy-Shop an – ohne Anfrage und ohne Wartezeit.',
        label: 'Zum Etsy-Shop',
        href: etsy_url,
        external: true,
        image: asset('images/etsy-shop.jpg'),
        imageAlt: 'Im 3D-Druck gefertigte Korbschalen und Untersetzer in Blau und Weiß'
    }, with_context = false) }}

    {# ── Ablauf (dunkel) ────────────────────────────────────────── #}
    {# One step shallower than the other sections: since the steps do
       without a box, this block carries half the content of, say, the blog
       section, and at the same padding that is twice the air per line. It
       stays the dark pause in the rhythm all the same. #}
    <section class="bg-neutral-950">
        <div class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-20">
            <div class="max-w-2xl">
                {{ include('partials/_eyebrow.html.twig', { text: 'Ablauf', tone: 'dark' }) }}
                <h2 class="mt-5 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">In drei Schritten zum gedruckten Teil</h2>
            </div>

            {# Wording and the three parts follow the printed poster: title,
               explanation, punchline. What stands on paper and what stands
               on the page tell the same story in the same words. #}
            <ol class="mt-12 grid gap-10 md:grid-cols-3">
                {% set steps = [
                    { no: '01', title: 'Du hast die Idee.', text: 'Ob fertiges Modell, grobe Skizze oder nur eine erste Vorstellung.', note: 'Sprich uns an – wir helfen.' },
                    { no: '02', title: 'Wir drucken.', text: 'Ob ein oder hundert Stück. Auf Wunsch farbig, aber immer maßhaltig.', note: 'In Tagen – nicht Wochen.' },
                    { no: '03', title: 'Du hältst es in der Hand.', text: 'Deine Idee ist nun Realität. Ob Geschenk, Ersatzteil, Werkzeug oder Gadget.', note: 'Gedacht, gemacht – passt!' }
                ] %}
                {# The look of the printed poster: a rule above the figure
                   rather than a box. On the dark ground the rule takes a
                   muted step of white, so it marks the division without
                   outshining the figure. #}
                {% for step in steps %}
                    <li class="border-t-2 border-white/25 pt-5">
                        <span class="font-mono text-2xl font-bold text-accent-on-dark">{{ step.no }}</span>
                        <h3 class="mt-4 font-display text-lg font-bold text-white">{{ step.title }}</h3>
                        <p class="mt-3 text-sm leading-relaxed text-neutral-400">{{ step.text }}</p>
                        <p class="mt-4 text-sm font-semibold leading-relaxed text-accent-on-dark">{{ step.note }}</p>
                    </li>
                {% endfor %}
            </ol>

            {# The filled button leads to the way that carries the promise;
               the arrow link keeps the other one open. One button and no
               second step, so the alternative is a link and not a rival. #}
            <div class="mt-10 flex flex-wrap items-center gap-6">
                {{ include('partials/_button.html.twig', { href: path('app_print_order'), label: 'Ich habe ein fertiges Modell gefunden' }, with_context = false) }}
                {{ include('partials/_link_arrow.html.twig', { href: path('app_contact'), label: 'Ich habe eine eigene Idee', tone: 'dark' }, with_context = false) }}
            </div>
        </div>
    </section>

    {# ── Team ───────────────────────────────────────────────────── #}
    {# The text runs at reading width and the portraits get a row of their
       own below it, across the full width. Beside the long text they stood
       too small and were lost. #}
    <section class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
        <div class="max-w-3xl">
            {{ include('partials/_eyebrow.html.twig', { text: 'Team' }) }}
            <h2 class="mt-5 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
                Wer wir sind?
                <span class="mt-3 block text-[0.8em] text-accent-on-light">Ein Familienunternehmen</span>
            </h2>
            <div class="mt-6 space-y-4 text-base leading-relaxed text-neutral-600">
                <p>Kurz nachdem Marcel Mitte 2022 seinen ersten 3D-Drucker gekauft hat, gab es für ihn kein Halten mehr: Seine Leidenschaft für die additive Fertigung und den 3D-Druck war geweckt. Seine eigenen Ideen in die Realität zu bringen und Schicht für Schicht wachsen zu sehen, wird auch nach mehreren Jahren nicht langweilig.</p>
                <p>Mittlerweile gibt es vier 3D-Drucker in unserer kleinen Farm. Diese laufen rund um die Uhr und fertigen Ersatz- und Zubehörteile für <a class="font-semibold text-accent-on-light transition-colors hover:text-accent-on-light-hover" href="https://www.myknight.de" title="Marcel restauriert seit 2014 einen Pontiac Firebird Trans Am und verwandelt ihn Stück für Stück in das Wunderauto „K.I.T.T.“ aus der Hit-Serie „Knight Rider“">Marcels K.I.T.T.-Replika</a> und andere Fahrzeuge, Deko-Artikel für die Wohnung, Werkzeuge für die Werkstatt und vieles mehr.</p>
                <p>Dank über zwanzig Jahren Erfahrung als <a class="font-semibold text-accent-on-light transition-colors hover:text-accent-on-light-hover" href="https://www.krausgebaut.de" title="Unter der Marke krausgebaut bietet Marcel Internet- &amp; IT-Dienstleistungen an">Software-Entwickler &amp; IT-Dienstleister</a> war der weitere Weg klar: eine eigene Internetpräsenz für unser neues Angebot. Daraus entstand <span class="font-semibold text-neutral-900">krausgedruckt</span>, ein kleines Familienunternehmen.</p>
            </div>
        </div>

        {# The same card as in the blog section: picture edge to edge across
           the full width, text below it. Round portraits in a box are the
           most generic team pattern there is, and the box competes with the
           photograph instead of carrying it. #}
        <ul class="mt-14 grid gap-6 sm:grid-cols-3">
            {% set team = [
                { name: 'Marcel', role: 'Technik, Kommunikation', image: 'images/marcel.jpg', alt: 'Marcel Kraus' },
                { name: 'Manuela', role: 'Shop, Produktauswahl, Kommunikation', image: 'images/manuela.jpg', alt: 'Manuela Kraus' },
                { name: 'Lucky', role: 'Gute Seele, Ruhepol', image: 'images/lucky.jpg', alt: 'Prinz Lukas von Plüsch' }
            ] %}
            {% for member in team %}
                <li>
                    {% embed 'partials/_card.html.twig' with {
                        title: member.name,
                        image: asset(member.image),
                        alt: member.alt,
                        role: member.role
                    } only %}
                        {% block media %}
                            <img class="aspect-square w-full object-cover" src="{{ image }}" alt="{{ alt }}" loading="lazy">
                        {% endblock %}

                        {% block body %}
                            <p class="mt-2 text-sm leading-relaxed text-neutral-600">{{ role }}</p>
                        {% endblock %}
                    {% endembed %}
                </li>
            {% endfor %}
        </ul>
    </section>

    {{ include('partials/_conversion_band.html.twig', { title: 'Und jetzt deins?', text: 'Erzähle uns von deiner Idee – unverbindlich und ohne Kosten. Wir melden uns mit einer Einschätzung zurück.' }, with_context = false) }}

    {# ── Verweis auf die Schwestermarke ─────────────────────────── #}
    {{ include('partials/_sibling_band.html.twig', {
        title: 'Deine Idee soll auch digital laufen?<br>Software baut Marcel auch.',
        text: 'Neben dem 3D-Druck bietet Marcel mit <strong>krausgebaut</strong> auch Internet- &amp; IT-Dienstleistungen in Erftstadt bei Köln an.',
        href: 'https://www.krausgebaut.de',
        label: 'krausgebaut besuchen'
    }, with_context = false) }}

{% endblock %}

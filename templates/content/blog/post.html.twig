{# One post of the blog, laid out like a reference was: the head on the
   warm ground, the cover below it, the blocks in one `prose` container.

   `meta_title` carries no brand – kongtent leaves that to the channel – so
   the title appends it. The date is printed with `timezone: false`, because
   it carries the offset out of the payload and a post dated just after
   midnight would otherwise stand under the wrong day. The blocks this site
   sets itself carry `not-prose`; the plugin styles only what the bundle
   renders. The teaser went through the converter and stands outside
   `prose`, so it carries `data-generated`.
   Expects: post. #}
{% extends 'base.html.twig' %}

{% block title %}{{ post.metaTitle }} · krausgedruckt von Marcel Kraus{% endblock %}
{% block meta_description %}{{ post.metaDescription }}{% endblock %}

{% block main %}
    <article>
        <div class="border-b border-neutral-200 bg-surface-warm pt-20">
            <div class="mx-auto max-w-6xl px-6 py-12 lg:px-8 lg:py-16">
                {{ include('partials/_link_arrow.html.twig', {
                    href: path('app_blog'),
                    label: 'Alle Beiträge',
                    back: true,
                    tone: 'muted',
                }, with_context = false) }}

                <div class="mt-8 max-w-3xl">
                    {% if post.category %}
                        {{ include('partials/_eyebrow.html.twig', { text: post.category }, with_context = false) }}
                    {% endif %}
                    <h1 class="mt-5 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl lg:text-5xl">{{ post.headline }}</h1>
                    <p class="mt-5 text-lg leading-relaxed text-neutral-600" data-generated>{{ post.teaser|raw }}</p>
                </div>

                <p class="mt-10 font-mono text-xs uppercase tracking-[0.15em] text-neutral-600">
                    <time datetime="{{ post.date|date('Y-m-d', false) }}">{{ post.date|format_datetime(pattern: 'd. MMMM yyyy', locale: 'de', timezone: false) }}</time>
                </p>
            </div>
        </div>

        {% if post.coverImage %}
            <div class="mx-auto max-w-6xl px-6 pt-12 lg:px-8 lg:pt-16">
                <img class="aspect-4/3 w-full max-w-3xl rounded-2xl object-cover shadow-sm" src="{{ post.coverImage.getUrl() }}"{% if post.coverImage.getSourceSet() %} srcset="{{ post.coverImage.getSourceSet() }}" sizes="(min-width: 51rem) 48rem, calc(100vw - 3rem)"{% endif %} width="{{ post.coverImage.getWidth() }}" height="{{ post.coverImage.getHeight() }}" alt="{{ post.coverImage.alternativeText }}" fetchpriority="high">
            </div>
        {% endif %}

        <div class="mx-auto max-w-6xl px-6 py-12 lg:px-8 lg:py-16">
            <div class="prose prose-neutral max-w-3xl prose-a:font-semibold prose-a:text-accent-on-light prose-a:no-underline prose-a:hover:underline prose-headings:font-display">
                {% include '@Kongtent/blocks.html.twig' with { blocks: post.blocks } only %}
            </div>
        </div>

        {{ include('partials/_conversion_band.html.twig', { title: 'Und jetzt deins?', text: 'Erzähle uns von deiner Idee – unverbindlich und ohne Kosten.' }, with_context = false) }}
    </article>
{% endblock %}

{#- Whitespace is controlled by hand: an XML document may not begin with a blank line. -#}
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="de">
    <title>Blog · krausgedruckt</title>
    <subtitle>Meine kleine Druckfarm.</subtitle>
    <id>{{ url('app_blog') }}</id>
    <link rel="alternate" type="text/html" href="{{ url('app_blog') }}"/>
    <link rel="self" type="application/atom+xml" href="{{ url('app_blog_feed') }}"/>
    {# A feed needs `updated`; without a post the request time is the honest one. #}
    <updated>{{ (updated ?? 'now')|date('c', false) }}</updated>
    <author><name>krausgedruckt von Marcel Kraus</name></author>
{% for post in posts %}
    <entry>
        <title>{{ post.headline }}</title>
        <id>{{ url('app_blog_post', { year: post.getYear(), slug: post.slug }) }}</id>
        <link rel="alternate" type="text/html" href="{{ url('app_blog_post', { year: post.getYear(), slug: post.slug }) }}"/>
        <updated>{{ post.date|date('c', false) }}</updated>
        <summary type="html">{{ post.teaser|replace({'href="/': 'href="' ~ app.request.schemeAndHttpHost ~ '/'}) }}</summary>
        <content type="html">
            {%- if post.coverImage -%}
                {{- _self.picture(post.coverImage) -}}
            {%- endif -%}
            {%- for block in post.blocks -%}
                {%- if block.type == 'quote' -%}
                    &lt;blockquote&gt;&lt;p&gt;{{ block.html }}{% if block.source %}&lt;br&gt;– {{ block.source|e('html')|e('html') }}{% endif %}&lt;/p&gt;&lt;/blockquote&gt;
                    {#- `source` is escaped twice: a reader decodes the XML, then reads HTML. -#}
                {%- elseif block.type == 'image' -%}
                    {{- _self.picture(block.picture) -}}
                {%- elseif block.type == 'gallery' -%}
                    {%- for image in block.images -%}{{- _self.picture(image.picture) -}}{%- endfor -%}
                {%- elseif block.type == 'details' -%}
                    &lt;dl&gt;{% for item in block.items %}&lt;dt&gt;{{ item.label|e('html')|e('html') }}&lt;/dt&gt;&lt;dd&gt;{{ item.html|replace({'href="/': 'href="' ~ app.request.schemeAndHttpHost ~ '/'}) }}&lt;/dd&gt;{% endfor %}&lt;/dl&gt;
                {%- elseif block.type == 'embed' -%}
                    &lt;p&gt;&lt;a href="{{ block.url|e('html')|e('html') }}"&gt;{{ block.url|e('html')|e('html') }}&lt;/a&gt;&lt;/p&gt;
                {%- elseif block.type == 'heading' -%}
                    &lt;h{{ block.level }}&gt;{{ block.html }}&lt;/h{{ block.level }}&gt;
                {%- elseif block.type == 'list' -%}
                    {%- set tag = block.isOrdered() ? 'ol' : 'ul' -%}
                    &lt;{{ tag }}&gt;{% for item in block.items %}&lt;li&gt;{{ item }}&lt;/li&gt;{% endfor %}&lt;/{{ tag }}&gt;
                {%- elseif block.type == 'paragraph' -%}
                    {#- A feed reader cannot resolve a root-relative path. -#}
                    {{ block.html|replace({'href="/': 'href="' ~ app.request.schemeAndHttpHost ~ '/'}) }}
                {%- endif -%}
            {%- endfor -%}
        </content>
    </entry>
{% endfor %}
</feed>
{%- macro picture(picture) -%}
    &lt;p&gt;&lt;img src="{{ picture.url|e('html')|e('html') }}" alt="{{ picture.alternativeText|e('html')|e('html') }}"&gt;{% if picture.caption %}&lt;br&gt;{{ picture.caption|replace({'href="/': 'href="' ~ app.request.schemeAndHttpHost ~ '/'}) }}{% endif %}{% if picture.credit %}&lt;br&gt;Foto: {{ picture.credit|replace({'href="/': 'href="' ~ app.request.schemeAndHttpHost ~ '/'}) }}{% endif %}&lt;/p&gt;
{%- endmacro -%}

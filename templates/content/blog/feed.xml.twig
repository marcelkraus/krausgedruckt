{#- The feed of the blog, Atom.

    It carries the **full** text of every post, not the teaser: somebody who
    subscribes has said they want to read here, and half a post only sends
    them back to fetch the other half.

    The pictures ride along as plain `<img>`, without the caption chrome of the
    site – a feed reader brings its own stylesheet, and the frame of a figure is
    the page's decision, not the post's.

    Whitespace is controlled by hand: an XML document may not begin with a blank
    line, and Twig would leave one behind every tag. -#}
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="de">
    <title>Blog · krausgedruckt</title>
    <subtitle>Unsere kleine Druckfarm.</subtitle>
    <id>{{ url('app_blog') }}</id>
    <link rel="alternate" type="text/html" href="{{ url('app_blog') }}"/>
    <link rel="self" type="application/atom+xml" href="{{ url('app_blog_feed') }}"/>
    {# A feed without `updated` is invalid, and an empty one has no post to
       take the date from. Then the moment of the request is the honest answer:
       nothing has been published, and that is true right now. #}
    <updated>{{ (updated ?? 'now')|date('c', false) }}</updated>
    <author><name>krausgedruckt von Marcel Kraus</name></author>
{% for post in posts %}
    <entry>
        <title>{{ post.headline }}</title>
        <id>{{ url('app_blog_post', { year: post.getYear(), slug: post.slug }) }}</id>
        <link rel="alternate" type="text/html" href="{{ url('app_blog_post', { year: post.getYear(), slug: post.slug }) }}"/>
        <updated>{{ post.date|date('c', false) }}</updated>
        {# `type="html"`, because the teaser carries markup. Twig escapes it
           on the way out, which is exactly the form Atom asks for here. #}
        <summary type="html">{{ post.teaser }}</summary>
        <content type="html">
            {%- if post.coverImage -%}
                {{- _self.picture(post.coverImage) -}}
            {%- endif -%}
            {%- for block in post.blocks -%}
                {%- if block.type == 'quote' -%}
                    &lt;blockquote&gt;&lt;p&gt;{{ block.html }}{% if block.source %}&lt;br&gt;– {{ block.source|e('html')|e('html') }}{% endif %}&lt;/p&gt;&lt;/blockquote&gt;
                    {#- `html` is already HTML and takes the one escape Twig
                        gives it. `source` is text like every plain field here
                        and is escaped twice: inside `type="html"` a reader
                        decodes the XML and then reads HTML, and Twig takes a
                        single explicit `|e('html')` for safe and adds nothing.
                        Without the second pass a `<` in it injects markup into
                        the reader. -#}
                {%- elseif block.type == 'image' -%}
                    {{- _self.picture(block.picture) -}}
                {%- elseif block.type == 'gallery' -%}
                    {%- for image in block.images -%}{{- _self.picture(image.picture) -}}{%- endfor -%}
                {%- elseif block.type == 'details' -%}
                    &lt;dl&gt;{% for item in block.items %}&lt;dt&gt;{{ item.label|e('html')|e('html') }}&lt;/dt&gt;&lt;dd&gt;{{ item.html|replace({'href="/': 'href="' ~ app.request.schemeAndHttpHost ~ '/'}) }}&lt;/dd&gt;{% endfor %}&lt;/dl&gt;
                {%- elseif block.type == 'embed' -%}
                    &lt;p&gt;&lt;a href="{{ block.url|e('html')|e('html') }}"&gt;{{ block.url|e('html')|e('html') }}&lt;/a&gt;&lt;/p&gt;
                {%- elseif block.type == 'heading' -%}
                    &lt;h{{ block.level }}&gt;{{ block.html }}&lt;/h{{ block.level }}&gt;
                {%- elseif block.type == 'list' -%}
                    {%- set tag = block.isOrdered() ? 'ol' : 'ul' -%}
                    &lt;{{ tag }}&gt;{% for item in block.items %}&lt;li&gt;{{ item }}&lt;/li&gt;{% endfor %}&lt;/{{ tag }}&gt;
                {%- elseif block.type == 'paragraph' -%}
                    {#- A link in the body points at this site with a root-relative
                        path, which a feed reader resolves against its own address
                        or not at all. The host goes in front of it here rather
                        than on the page, where a relative path is right. -#}
                    {{ block.html|replace({'href="/': 'href="' ~ app.request.schemeAndHttpHost ~ '/'}) }}
                {%- endif -%}
            {%- endfor -%}
        </content>
    </entry>
{% endfor %}
</feed>
{#- One picture as the feed carries it: the cover, a picture in the text and
    every picture of a gallery alike. -#}
{%- macro picture(picture) -%}
    &lt;p&gt;&lt;img src="{{ picture.url|e('html')|e('html') }}" alt="{{ picture.alternativeText|e('html')|e('html') }}"&gt;{% if picture.caption %}&lt;br&gt;{{ picture.caption|e('html')|e('html') }}{% endif %}{% if picture.credit %}&lt;br&gt;Foto: {{ picture.credit|e('html')|e('html') }}{% endif %}&lt;/p&gt;
{%- endmacro -%}

{# The overview of the blog: every post of the channel as a card, newest
   first, the way the references were listed.
   Expects: posts. #}
{% extends 'base.html.twig' %}

{% block title %}Blog · krausgedruckt von Marcel Kraus{% endblock %}
{% block meta_description %}Einblicke in unsere kleine Druckfarm in Erftstadt bei Köln: gedruckte Ersatzteile, Werkzeuge und Dekostücke von krausgedruckt.{% endblock %}

{% block main %}
    <section class="border-b border-neutral-200 bg-surface-warm pt-20">
        <div class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-20">
            <div class="max-w-3xl">
                {{ include('partials/_eyebrow.html.twig', { text: 'Blog' }) }}
                <h1 class="mt-5 font-display text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl">
                    Druckfrisch präsentiert.
                    <span class="mt-3 block text-[0.8em] text-accent-on-light">Bunte Einblicke in unsere kleine Druckfarm.</span>
                </h1>
            </div>
        </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-20">
        <h2 class="sr-only">Alle Beiträge</h2>
        {% if posts %}
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {% for post in posts %}
                    {{ include('partials/_post_card.html.twig', { post: post }, with_context = false) }}
                {% endfor %}
            </div>
        {% else %}
            <p class="text-base leading-relaxed text-neutral-600">Hier ist gerade nichts zu sehen – wir arbeiten daran.</p>
        {% endif %}

        <div class="mt-12">
            {{ include('partials/_link_arrow.html.twig', {
                href: instagram_url,
                label: 'Laufend weitere Inhalte auf Instagram',
                icon: 'external',
                external: true,
            }, with_context = false) }}
        </div>
    </section>

    {{ include('partials/_conversion_band.html.twig', { title: 'Und jetzt deins?', text: 'Erzähle uns von deiner Idee – unverbindlich und ohne Kosten.' }, with_context = false) }}
{% endblock %}

{% extends 'base.html.twig' %}

{# The landing page stands apart from the site, so the header is reduced to
   a way back. The enquiry button stays — the page links to contact routes
   three times in its own copy. #}
{% set nav_items = [
    { label: 'Zur Übersicht', route: 'app_homepage', matches: [] }
] %}

{% block meta_robots %}<meta name="robots" content="noindex,follow">{% endblock %}
{% block title %}adVintage: Ein besonderes Angebot für dich · krausgedruckt von Marcel Kraus{% endblock %}
{% block meta_description %}krausgedruckt und adVintage haben sich zusammengetan und einen modularen Hutständer für deinen Fedora entwickelt – und darüber hinaus noch ein besonderes Angebot für dich.{% endblock %}

{% block main %}
    {# ── Hero ───────────────────────────────────────────────────── #}
    <section class="relative isolate flex min-h-[24rem] items-center overflow-hidden border-b border-neutral-200 pt-20 lg:min-h-[28rem]">
        <img src="{{ asset('images/advintage-landing-page/hero.jpg') }}" alt="" aria-hidden="true" class="absolute inset-0 -z-20 h-full w-full object-cover">
        {# A gradient scrim rather than a flat veil: the type stays readable
           regardless of what sits behind it in the crop.

           Its direction follows the type. From `lg` up the headline sits in
           the left half, so the scrim runs to the right and leaves the photo
           breathing on the far side. Below that the headline spans the full
           width, where a horizontal scrim would drop its right end onto the
           bright part of the picture — so the scrim runs upwards instead and
           carries the type across the whole line. #}
        <div class="absolute inset-0 -z-10 bg-gradient-to-t from-neutral-950/90 to-neutral-950/50 lg:bg-gradient-to-r lg:from-neutral-950/90 lg:via-neutral-950/70 lg:to-neutral-950/30"></div>

        <div class="mx-auto w-full max-w-6xl px-6 py-16 lg:px-8 lg:py-20">
            <div class="max-w-xl">
                {{ include('partials/_eyebrow.html.twig', { text: 'krausgedruckt × adVintage', tone: 'dark' }) }}
                <h1 class="mt-5 font-display text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl">
                    Fortune &amp; Glory, Kid!
                    <span class="mt-3 block text-[0.8em] text-accent-on-dark">We ❤ adVintage.</span>
                </h1>
            </div>
        </div>
    </section>

    {# ── Text ───────────────────────────────────────────────────── #}
    <section class="bg-surface-warm">
        <div class="mx-auto max-w-3xl px-6 py-16 lg:py-20">
            <h2 class="font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
                Deine Wahl?
                <span class="mt-3 block text-[0.8em] text-accent-on-light">War weise.</span>
            </h2>

            <div class="mt-8 space-y-4 text-base leading-relaxed text-neutral-600">
                <p>Wir sind Marcel und Manuela, stolze Besitzer mehrerer Hüte von adVintage, große Fans von Thomas und seiner Arbeit als Hutmacher – und die Menschen hinter <span class="font-semibold text-neutral-900">krausgedruckt</span>.</p>
                <p>Du hast die Chance genutzt und einen modularen adVintage-Hutständer erworben. Dafür danken wir dir und wünschen dir viel Spaß damit! Der Hutständer wurde mit bestem Material aus Deutschland auf Druckern von Prusa Research aus Tschechien gedruckt und wir hoffen sehr, er gefällt dir!</p>
                <p>Wir haben diese Landing Page für dich und die anderen stolzen Besitzer eingerichtet, als kleine Einladung, tiefer in die Welt des 3D-Drucks einzutauchen. Unten findest du ein paar Modelle aus der Welt von Indiana Jones, bereitgestellt von kreativen Menschen auf den Portalen <a class="font-semibold text-accent-on-light transition-colors hover:text-accent-on-light-hover" href="https://www.printables.com">Printables</a> und <a class="font-semibold text-accent-on-light transition-colors hover:text-accent-on-light-hover" href="https://www.thingiverse.com">Thingiverse</a>.</p>
            </div>

            {# The offer, set apart on the accent. #}
            <div class="mt-8 rounded-2xl border border-accent/30 bg-white p-8 text-center shadow-sm">
                <p class="text-base leading-relaxed text-neutral-600">Schick uns ein Foto deines Hutes auf deinem Hutständer, oder poste es auf Instagram und markiere <a class="font-semibold text-accent-on-light transition-colors hover:text-accent-on-light-hover" href="{{ instagram_url }}" title="krausgedruckt auf Instagram">@krausgedruckt</a>, und erhalte satte</p>
                <p class="my-4 font-display text-3xl font-bold text-accent-on-light">20 % Rabatt</p>
                <p class="text-base leading-relaxed text-neutral-600">auf deine erste Bestellung bei uns!</p>
                {# Das Kontaktformular kann den Code aus der Adresszeile
                   übernehmen; ohne diesen Knopf blieb die Mechanik ungenutzt. #}
                <div class="mt-6">
                    {{ include('partials/_button.html.twig', {
                        href: path('app_contact', { 'discount-code': 'ADVINTAGE' }),
                        label: 'Rabatt einlösen',
                        icon: 'arrow'
                    }, with_context = false) }}
                </div>
            </div>

            <div class="mt-8 space-y-4 text-base leading-relaxed text-neutral-600">
                <p>Das Angebot gilt natürlich für <em>alle Modelle</em>, die du auf <em>allen Portalen</em> findest, es muss auch keinen Bezug zu Indiana Jones haben. Beachte nur bitte, dass dieses Angebot nur für Drucke für private Zwecke gilt.</p>
                <p>Bei Fragen stehen wir dir <a class="font-semibold text-accent-on-light transition-colors hover:text-accent-on-light-hover" href="{{ path('app_contact') }}">über das Kontaktformular</a> jederzeit zur Verfügung. Und falls du keine Kontaktformulare magst, erreichst du uns auch <a class="font-semibold text-accent-on-light transition-colors hover:text-accent-on-light-hover" href="{{ path('app_contact_email') }}">per E-Mail</a> oder <a class="font-semibold text-accent-on-light transition-colors hover:text-accent-on-light-hover" href="{{ path('app_contact_whats_app') }}">per WhatsApp</a>.</p>
                <p class="font-semibold text-neutral-900">
                    Keep on Exploring,<br>
                    Keep on Printing!
                </p>
            </div>
        </div>
    </section>

    {# ── Modelle ────────────────────────────────────────────────── #}
    <section class="border-t border-neutral-200">
        <div class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-20">
            {{ include('partials/_eyebrow.html.twig', { text: 'Modelle zum Nachdrucken' }) }}
            <h2 class="mt-5 font-display text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl">Aus der Welt von Indiana Jones</h2>

            <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {% for printableModel in printableModels %}
                    {% embed 'partials/_card.html.twig' with {
                        href: printableModel.modelUrl,
                        title: printableModel.modelName,
                        meta: printableModel.platform,
                        external: true,
                        image: asset('images/advintage-landing-page/' ~ printableModel.imageName),
                        authorName: printableModel.authorName,
                        authorUrl: printableModel.authorUrl
                    } only %}
                        {% block media %}
                            <a href="{{ href }}" tabindex="-1" aria-hidden="true">
                                <img class="aspect-4/3 w-full object-cover" src="{{ image }}" alt="{{ title }}" loading="lazy">
                            </a>
                        {% endblock %}

                        {% block body %}
                            <p class="mt-2 flex-1 text-sm leading-relaxed text-neutral-600">Von <a class="relative z-10 font-semibold text-accent-on-light transition-colors hover:text-accent-on-light-hover" href="{{ authorUrl }}">{{ authorName }}</a></p>
                        {% endblock %}
                    {% endembed %}
                {% endfor %}
            </div>
        </div>
    </section>
{% endblock %}

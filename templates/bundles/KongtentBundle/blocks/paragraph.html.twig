{# A paragraph that is one external link and nothing else is set as an arrow link. #}
{% set link = block.html|sole_external_link(app.request.host) %}
{% if link %}
    <p class="not-prose my-6">{{ include('partials/_link_arrow.html.twig', {
        href: link.href,
        label: link.label,
        icon: 'external',
        external: true,
    }, with_context = false) }}</p>
{% else %}
    {{ block.html|raw }}
{% endif %}

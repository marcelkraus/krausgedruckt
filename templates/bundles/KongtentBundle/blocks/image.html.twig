{# **This site's version.** A picture as wide as the text column, with its
   corners and its caption line in the voice of the site. Width and height
   come from the payload, so the text below does not jump while it loads. #}
<figure class="not-prose my-8">
    <img class="w-full rounded-2xl shadow-sm" src="{{ block.picture.getUrl() }}"{% if block.picture.getSourceSet() %} srcset="{{ block.picture.getSourceSet() }}" sizes="(min-width: 51rem) 48rem, calc(100vw - 3rem)"{% endif %} width="{{ block.picture.getWidth() }}" height="{{ block.picture.getHeight() }}" alt="{{ block.picture.alternativeText }}" loading="lazy" decoding="async">
    {% if block.picture.caption or block.picture.credit %}
        <figcaption class="mt-3 text-sm leading-relaxed text-neutral-600">
            {{- block.picture.caption -}}
            {%- if block.picture.caption and block.picture.credit %} · {% endif -%}
            {%- if block.picture.credit %}Foto: {{ block.picture.credit }}{% endif -%}
        </figcaption>
    {% endif %}
</figure>

{# Hand-rolled contact form – no symfony/form, the same mechanism the sister
   project uses, so one submission path exists in the family instead of two.

   The field classes are in `_field_class`, which the assistant pulls too;
   this file holds the layout and the order of the fields.

   Expects: errors (map field→message), old (submitted values), ts + ts_sig
   (the signed anti-spam timestamp), focus (optional, first invalid field). #}
{% import _self as field %}

{% macro label(name, text, required) %}
    <label for="f_{{ name }}" class="block font-mono text-xs uppercase tracking-[0.15em] text-neutral-600">{{ text }}{% if required %} <span class="text-accent-on-light" aria-hidden="true">*</span>{% endif %}</label>
{% endmacro %}

{% macro input(name, text, old, errors, options) %}
    {% set options = options|default({}) %}
    {% set error = errors[name]|default(null) %}
    {% set required = options.required|default(false) %}
    <div>
        {{ _self.label(name, text, required) }}
        <input type="{{ options.type|default('text') }}" id="f_{{ name }}" name="{{ name }}" value="{{ old[name]|default('') }}"
               {% if options.autocomplete is defined %}autocomplete="{{ options.autocomplete }}"{% endif %}
               {% if required %}aria-required="true"{% endif %}
               class="{{ include('partials/_field_class.html.twig', { invalid: error is not null }, with_context = false) }}"
               {% if error %}aria-invalid="true" aria-describedby="e_{{ name }}"{% endif %}>
        {% if error %}<p id="e_{{ name }}" class="mt-2 text-sm font-semibold text-error">{{ error }}</p>{% endif %}
    </div>
{% endmacro %}

<form method="post" action="{{ path('app_contact') }}" novalidate{% if focus is defined and focus %} data-error-focus="{{ focus }}"{% endif %}>
    <input type="hidden" name="_token" value="{{ csrf_token('contact') }}">
    <input type="hidden" name="ts" value="{{ contact_timestamp }}">
    <input type="hidden" name="ts_sig" value="{{ contact_timestamp_signature }}">

    {# Honeypot: hidden from people, tempting to bots. A neutral field name
       that browser autofill is unlikely to populate for a real visitor. #}
    <div class="sr-only" aria-hidden="true">
        <label for="f_website">Dieses Feld bitte leer lassen</label>
        <input type="text" id="f_website" name="website" tabindex="-1" autocomplete="off">
    </div>

    {% if errors.form is defined %}
        <p class="mb-5 rounded-lg border border-error-border bg-error-surface px-4 py-3 text-sm font-semibold text-error-on-surface" role="alert">{{ errors.form }}</p>
    {% endif %}

    {# The two required fields open the form. Anything optional follows in the
       second row, so a private customer – the majority here – starts with
       something that concerns them rather than skipping a field first. #}
    <div class="grid gap-5 sm:grid-cols-2">
        {{ field.input('name', 'Name', old, errors, { required: true, autocomplete: 'name' }) }}
        {{ field.input('email', 'E-Mail', old, errors, { required: true, type: 'email', autocomplete: 'email' }) }}
    </div>

    <div class="mt-5 grid gap-5 sm:grid-cols-2">
        {{ field.input('phone', 'Telefon', old, errors, { type: 'tel', autocomplete: 'tel' }) }}
        {{ field.input('discountCode', 'Rabattcode', old, errors) }}
    </div>

    <div class="mt-5">
        {{ field.label('message', 'Nachricht', true) }}
        <textarea id="f_message" name="message" rows="6" aria-required="true"
                  {% if errors.message is defined %}aria-invalid="true" aria-describedby="e_message"{% endif %}
                  class="{{ include('partials/_field_class.html.twig', { invalid: errors.message is defined }, with_context = false) }}">{{ old.message|default('') }}</textarea>
        {% if errors.message is defined %}<p id="e_message" class="mt-2 text-sm font-semibold text-error">{{ errors.message }}</p>{% endif %}
        <p class="mt-2 text-sm text-neutral-600">Falls du auf der Suche nach einem Rabattcode bist, schau doch mal in unsere App.</p>
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-4">
        <button type="submit" class="{{ include('partials/_button_class.html.twig', {}, with_context = false) }}">Nachricht senden</button>
        <p class="font-mono text-xs text-neutral-600">Pflichtfelder <span class="text-accent-on-light">*</span></p>
    </div>

    <p class="mt-5 text-sm leading-relaxed text-neutral-600">Mit dem Absenden stimmst du unserer <a class="font-semibold text-accent-on-light transition-colors hover:text-accent-on-light-hover" href="{{ path('app_data_privacy') }}">Datenschutzerklärung</a> zu.</p>
</form>

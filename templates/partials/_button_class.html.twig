{# A class string, so an <a> and a <button> share one skin. The hover lightens;
   darkening drops the label to 3.43:1. Params: size ('default' or 'compact', 44 px high). #}
{%- set size = size|default('default') -%}
{%- set base = 'group inline-flex items-center gap-2 rounded-lg bg-accent font-mono font-semibold uppercase tracking-[0.15em] text-neutral-900 transition-colors hover:bg-accent-hover' -%}
{%- set measures = size == 'compact'
    ? 'h-11 px-4 text-xs sm:px-5'
    : 'px-6 py-3.5 text-sm' -%}
{{- base ~ ' ' ~ measures -}}

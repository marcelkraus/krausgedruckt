{# The closing nod to the sister brand – the bookend both sites carry, so a
   visitor who lands on the wrong one still finds the right one.

   It is the mirror of the block krausgebaut ends its homepage with: there a
   papaya glow on petrol, here a petrol glow on near-black. The sibling's
   color comes from its own brand token and stays out of the accent scale,
   and the type on the dark ground uses the brighter step – the petrol is too
   dark to be read on black.

   Params: title, subtitle (the accent second line), text, href, label. #}
{% import 'partials/_icons.html.twig' as icons %}
<section class="relative isolate overflow-hidden border-t border-neutral-800 bg-neutral-950">
    <div class="pointer-events-none absolute -top-24 -right-32 -z-10 h-[28rem] w-[28rem] rounded-full bg-brand-krausgebaut/25 blur-[120px]"></div>
    <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-20 lg:flex-row lg:items-center lg:justify-between lg:gap-12 lg:px-8">
        <div class="max-w-2xl">
            {{ include('partials/_eyebrow.html.twig', { text: 'krausgebaut', tone: 'krausgebaut' }, with_context = false) }}
            <h2 class="mt-5 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">{{ title|raw }}</h2>
            <p class="mt-5 text-lg leading-relaxed text-neutral-400">{{ text|raw }}</p>
        </div>
        <a href="{{ href }}" class="group inline-flex shrink-0 items-center gap-2 self-start rounded-lg bg-brand-krausgebaut px-6 py-3.5 font-mono text-sm font-semibold uppercase tracking-[0.15em] text-white transition-colors hover:bg-brand-krausgebaut-hover lg:self-auto">
            {{ label }}
            <span class="transition-transform group-hover:translate-x-1">{{ icons.icon('external', 'h-4 w-4') }}</span>
        </a>
    </div>
</section>

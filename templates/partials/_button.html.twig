{# Params: href, label, icon (overrides the default arrow or off-site icon),
   external, class. #}
{% import 'partials/_icons.html.twig' as icons %}
{% set icon = icon|default(external|default(false) ? 'external' : 'arrow') %}
<a href="{{ href }}" class="{{ include('partials/_button_class.html.twig', {}, with_context = false) }} {{ class|default('') }}"{% if external|default(false) %} target="_blank" rel="noopener"{% endif %}>
    {{ label }}
    <span class="transition-transform group-hover:translate-x-1">{{ icons.icon(icon, 'h-4 w-4') }}</span>
</a>

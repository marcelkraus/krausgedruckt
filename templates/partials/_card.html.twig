{# Embedded; with an href the heading link stretches over the card. Params: title,
   href, meta, datetime, external. Blocks: media, body. #}
{% set has_target = href|default(null) %}
<article class="flex flex-col overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm{% if has_target %} relative transition-shadow hover:shadow-lg hover:shadow-neutral-200/60{% endif %}{% if class is defined and class %} {{ class }}{% endif %}">
    {% block media %}{% endblock %}

    <div class="flex flex-1 flex-col p-6">
        <h3 class="font-display text-base font-bold text-neutral-900">
            {%- if has_target -%}
                <a href="{{ href }}" class="transition-colors after:absolute after:inset-0 hover:text-accent-on-light"{% if external|default(false) %} target="_blank" rel="noopener"{% endif %}>{{ title }}</a>
            {%- else -%}
                {{ title }}
            {%- endif -%}
        </h3>

        {% block body %}{% endblock %}

        {% if meta|default(null) %}
            <p class="mt-4 font-mono text-xs uppercase tracking-[0.15em] text-neutral-600">
                {%- if datetime|default(null) %}<time datetime="{{ datetime }}">{{ meta }}</time>{% else %}{{ meta }}{% endif -%}
            </p>
        {% endif %}
    </div>
</article>

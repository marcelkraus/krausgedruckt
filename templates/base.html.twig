{% import 'partials/_icons.html.twig' as icons %}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% block meta_robots %}<meta name="robots" content="index,follow">{% endblock %}
    <meta name="description" content="{% block meta_description %}{% block brand_description %}krausgedruckt von Marcel Kraus: individueller 3D-Druck aus Erftstadt bei Köln – Einzelteile, Kleinserien und Prototypen nach deinen Vorgaben.{% endblock %}{% endblock %}">
    <title>{% block title %}krausgedruckt von Marcel Kraus · 3D-Druck aus Erftstadt bei Köln{% endblock %}</title>

    <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="32x32">
    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-touch-icon.png') }}">

    <link rel="canonical" href="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">

    {# Captured, because the card needs the path twice. #}
    {% set meta_image %}{% block meta_image %}images/sharing.jpg{% endblock %}{% endset %}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="krausgedruckt">
    <meta property="og:locale" content="de_DE">
    <meta property="og:title" content="{{ block('title') }}">
    <meta property="og:description" content="{{ block('meta_description') }}">
    <meta property="og:url" content="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">
    <meta property="og:image" content="{{ app.request.schemeAndHttpHost ~ asset(meta_image) }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ block('title') }}">
    <meta name="twitter:description" content="{{ block('meta_description') }}">
    <meta name="twitter:image" content="{{ app.request.schemeAndHttpHost ~ asset(meta_image) }}">

    <link rel="alternate" type="application/atom+xml" title="Blog · krausgedruckt" href="{{ path('app_blog_feed') }}">

    {% block structured_data %}{% endblock %}

    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/output.css') }}">
    {% endblock %}

    {% if app.environment == 'prod' %}
        {# Cookieless, so no consent banner is needed. #}
        <script>
            var _paq = window._paq = window._paq || [];
            _paq.push(['disableCookies']);
            _paq.push(['trackPageView']);
            _paq.push(['enableLinkTracking']);
            (function () {
                var u = "https://analytics.krausgebaut.de/";
                _paq.push(['setTrackerUrl', u + 'matomo.php']);
                _paq.push(['setSiteId', '8']);
                var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
                g.async = true; g.src = u + 'matomo.js'; s.parentNode.insertBefore(g, s);
            })();
        </script>
    {% endif %}
</head>
<body class="min-h-screen bg-white font-sans text-neutral-600 antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-neutral-900 focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:uppercase focus:tracking-wider focus:text-white">Zum Inhalt springen</a>

    {# A page may narrow the list by setting `nav_items` at its top level. #}
    {% set nav_items = nav_items|default([
        { label: 'Modell drucken', route: 'app_print_order', matches: ['app_print_order'] },
        { label: 'Blog', route: 'app_blog', matches: ['app_blog', 'app_blog_post'] },
        { label: 'App', route: 'app_app', matches: ['app_app'] },
        { label: 'FAQ', route: 'app_faq', matches: ['app_faq'] },
        { label: 'Shop', url: etsy_url, external: true }
    ]) %}
    {% set current_route = app.request.attributes.get('_route') %}

    {# A fixed first column from lg gives both siblings the same navigation edge. #}
    <header class="fixed inset-x-0 top-0 z-50 border-b border-neutral-200 bg-white/90 backdrop-blur-sm">
        <div class="mx-auto grid h-20 max-w-6xl grid-cols-[auto_1fr_auto] lg:grid-cols-[10rem_1fr_auto] items-center gap-6 px-6 lg:px-8">
            <a href="{{ path('app_homepage') }}" class="inline-flex items-center" aria-label="Startseite">
                {{ include('partials/_logo.html.twig', { class: 'h-8 w-auto md:h-9' }, with_context = false) }}
            </a>

            <nav class="hidden items-center gap-8 lg:flex" aria-label="Hauptnavigation">
                {% for item in nav_items %}
                    {% set is_current = current_route in item.matches|default([]) %}
                    <a href="{{ item.url|default(null) ?: path(item.route) }}"
                       class="inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-[0.15em] transition-colors hover:text-accent-on-light {{ is_current ? 'font-semibold text-accent-on-light' : 'text-neutral-600' }}"
                       {% if is_current %}aria-current="page"{% endif %}
                       {% if item.external|default(false) %}target="_blank" rel="noopener"{% endif %}>{{ item.label }}{% if item.external|default(false) %}{{ icons.icon('external', 'h-3.5 w-3.5') }}{% endif %}</a>
                {% endfor %}
            </nav>

            <div class="col-start-3 flex items-center justify-self-end gap-3">
                <a href="{{ path('app_contact') }}" class="{{ include('partials/_button_class.html.twig', { size: 'compact' }, with_context = false) }}">
                    <span class="sm:hidden">{{ icons.icon('mail', 'h-5 w-5') }}</span>
                    <span class="sr-only sm:not-sr-only">Jetzt anfragen</span>
                </a>

                <button type="button" id="menu-toggle" class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-neutral-900 lg:hidden" aria-controls="mobile-menu" aria-expanded="false" aria-label="Menü öffnen">
                    <svg data-menu-icon="closed" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"/></svg>
                    <svg data-menu-icon="open" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
                </button>
            </div>
        </div>

        <div id="mobile-menu" class="hidden border-t border-neutral-200 bg-white lg:hidden">
            <nav class="mx-auto flex max-w-6xl flex-col px-6 py-2" aria-label="Mobile Navigation">
                {% for item in nav_items %}
                    {% set is_current = current_route in item.matches|default([]) %}
                    <a href="{{ item.url|default(null) ?: path(item.route) }}"
                       class="inline-flex items-center gap-1.5 border-b border-neutral-100 py-3 font-mono text-sm uppercase tracking-[0.15em] hover:text-accent-on-light {{ is_current ? 'font-semibold text-accent-on-light' : 'text-neutral-600' }}"
                       {% if is_current %}aria-current="page"{% endif %}
                       {% if item.external|default(false) %}target="_blank" rel="noopener"{% endif %}
                       data-menu-link>{{ item.label }}{% if item.external|default(false) %}{{ icons.icon('external', 'h-3.5 w-3.5') }}{% endif %}</a>
                {% endfor %}
                <a href="{{ path('app_contact') }}" class="{{ include('partials/_button_class.html.twig', {}, with_context = false) }} mt-4 mb-3 justify-center" data-menu-link>Jetzt anfragen</a>
            </nav>
        </div>
    </header>

    <main id="main" tabindex="-1">
        {% block main %}{% endblock %}
    </main>

    {% block footer %}
        <footer class="border-t border-neutral-800 bg-neutral-900 text-neutral-400">
            <div class="mx-auto max-w-6xl px-6 py-16 lg:px-8">
                <div class="grid gap-12 md:grid-cols-[1.5fr_1fr_1fr]">
                    <div>
                        {{ include('partials/_logo.html.twig', { class: 'h-9 w-auto text-white', mono: true }, with_context = false) }}
                        <p class="mt-5 max-w-xs text-sm leading-relaxed">{{ block('brand_description') }}</p>

                    </div>

                    <div>
                        <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-400">Kontakt &amp; Kanäle</h2>
                        <ul class="mt-4 space-y-1 text-sm">
                            <li><a href="{{ path('app_contact') }}" class="inline-flex items-center gap-2.5 py-2.5 transition-colors hover:text-white"><span class="inline-block h-2.5 w-2.5 shrink-0 rounded-[2px] bg-accent-on-dark" aria-hidden="true"></span>Kontaktformular</a></li>
                            <li><a href="{{ path('app_contact_email') }}" class="inline-flex items-center gap-2.5 py-2.5 transition-colors hover:text-white"><span class="inline-block h-2.5 w-2.5 shrink-0 rounded-[2px] bg-accent-on-dark" aria-hidden="true"></span>E-Mail</a></li>
                            <li><a href="{{ path('app_contact_whats_app') }}" class="inline-flex items-center gap-2.5 py-2.5 transition-colors hover:text-white"><span class="inline-block h-2.5 w-2.5 shrink-0 rounded-[2px] bg-accent-on-dark" aria-hidden="true"></span>WhatsApp</a></li>
                            <li><a href="{{ etsy_url }}" target="_blank" rel="noopener" class="inline-flex items-center gap-2.5 py-2.5 transition-colors hover:text-white"><span class="inline-block h-2.5 w-2.5 shrink-0 rounded-[2px] bg-accent-on-dark" aria-hidden="true"></span>Etsy-Shop</a></li>
                            <li><a href="{{ instagram_url }}" target="_blank" rel="noopener" class="inline-flex items-center gap-2.5 py-2.5 transition-colors hover:text-white"><span class="inline-block h-2.5 w-2.5 shrink-0 rounded-[2px] bg-accent-on-dark" aria-hidden="true"></span>Instagram</a></li>
                        </ul>
                    </div>

                    <div>
                        <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-400">Mehr von Marcel</h2>
                        <ul class="mt-4 space-y-1 text-sm">
                            <li><a href="https://www.marcelkraus.de" class="inline-flex items-center gap-2.5 py-2.5 transition-colors hover:text-white"><span class="inline-block h-2.5 w-2.5 shrink-0 rounded-[2px] bg-brand-marcelkraus-on-dark" aria-hidden="true"></span>marcelkraus</a></li>
                            <li><a href="https://www.krausgebaut.de" class="inline-flex items-center gap-2.5 py-2.5 transition-colors hover:text-white"><span class="inline-block h-2.5 w-2.5 shrink-0 rounded-[2px] bg-brand-krausgebaut-on-dark" aria-hidden="true"></span>krausgebaut</a></li>
                        </ul>
                    </div>
                </div>

                <div class="mt-14 flex flex-col gap-4 border-t border-neutral-800 pt-6 text-xs sm:flex-row sm:items-center sm:justify-between">
                    <p class="font-mono uppercase tracking-[0.15em] text-neutral-400">© {{ 'now'|date('Y') }} krausgedruckt von Marcel Kraus</p>
                    <nav class="flex gap-6" aria-label="Rechtliches">
                        <a href="{{ path('app_review') }}" class="py-2 transition-colors hover:text-white">Bewerten</a>
                        <a href="{{ path('app_imprint') }}" class="py-2 transition-colors hover:text-white">Impressum</a>
                        <a href="{{ path('app_data_privacy') }}" class="py-2 transition-colors hover:text-white">Datenschutz</a>
                    </nav>
                </div>
            </div>
        </footer>
    {% endblock %}

    {% block javascript %}
        <script>
            (function () {
                const toggle = document.getElementById('menu-toggle');
                const menu = document.getElementById('mobile-menu');
                if (toggle === null || menu === null) {
                    return;
                }

                const setOpen = (open) => {
                    menu.classList.toggle('hidden', open === false);
                    toggle.setAttribute('aria-expanded', String(open));
                    toggle.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
                    toggle.querySelector('[data-menu-icon="closed"]').classList.toggle('hidden', open);
                    toggle.querySelector('[data-menu-icon="open"]').classList.toggle('hidden', open === false);
                };

                toggle.addEventListener('click', () => {
                    setOpen(menu.classList.contains('hidden'));
                });

                menu.querySelectorAll('[data-menu-link]').forEach((link) => {
                    link.addEventListener('click', () => setOpen(false));
                });

                // A tap next to the open menu closes it.
                document.addEventListener('click', (event) => {
                    if (menu.classList.contains('hidden')) {
                        return;
                    }

                    if (menu.contains(event.target) === false && toggle.contains(event.target) === false) {
                        setOpen(false);
                    }
                });

                document.addEventListener('keydown', (event) => {
                    if (event.key === 'Escape' && menu.classList.contains('hidden') === false) {
                        setOpen(false);
                        toggle.focus();
                    }
                });

                window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
                    if (event.matches) {
                        setOpen(false);
                    }
                });
            }());
        </script>
    {% endblock %}
</body>
</html>
